[Unit]
Description=SR4-C LAN teaching console
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/agent-as-policy
ExecStart=/usr/bin/python3 -X faulthandler %h/agent-as-policy/scripts/web_control.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
